{
  "mcpServers": {
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp"
    },
    "mlflow": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--locked", "mlflow", "mcp", "run"],
      "env": {
        "MLFLOW_TRACKING_URI": "sqlite:///mlruns/mlflow.db",
        "MLFLOW_MCP_TOOLS": "experiments,runs",
        "MLFLOW_DISABLE_TELEMETRY": "true",
        "DO_NOT_TRACK": "true",
        "MLFLOW_DISABLE_AGENT_HINT": "1"
      }
    }
  }
}
